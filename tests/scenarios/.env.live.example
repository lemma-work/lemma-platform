# Copy to tests/scenarios/.env.live and fill in what you have.
#
# .env.* is gitignored. NEVER commit these, and never paste them into an issue,
# a pull request, or a chat — this is a public repository.
#
# Providers left blank are skipped, with a reason naming what is missing. See
# tests/scenarios/LIVE.md for what to create.

# A real model, so agent runs are not deterministic. Without it the live lane
# still runs, but its agents behave exactly as the fast lane's do.
LIVE_MODEL_API_KEY=
LIVE_MODEL=gpt-4o-mini
LIVE_MODEL_NAMES=gpt-4o-mini

# A fine-grained PAT scoped to one throwaway repository, with issues
# read/write. No OAuth round trip needed.
LIVE_GITHUB_TOKEN=
LIVE_GITHUB_REPO=your-name/lemma-live-scenarios

# An OAuth client with the Calendar and Gmail scopes, authorised once by hand.
# Keep the refresh token — an access token expires in an hour.
LIVE_GOOGLE_CLIENT_ID=
LIVE_GOOGLE_CLIENT_SECRET=
LIVE_GOOGLE_REFRESH_TOKEN=

# A bot from @BotFather, and the chat id of a conversation with it. The runner
# needs no public URL: the worker receives by polling.
LIVE_TELEGRAM_BOT_TOKEN=
LIVE_TELEGRAM_CHAT_ID=

# A Composio key with Gmail connected to the same Google account as above.
LIVE_COMPOSIO_API_KEY=
