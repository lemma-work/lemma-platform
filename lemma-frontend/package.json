{
  "name": "lemma-frontend",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "node server/dev-watch.mjs --dev",
    "build": "npm run lint && npm run check:naming && npm run check:design && next build",
    "start": "node server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --import ./tests/resolve.mjs --test tests/*.test.ts",
    "lint": "eslint src server scripts tests server.mjs",
    "check:naming": "node scripts/check-naming.mjs",
    "check:design": "node scripts/check-design.mjs && node scripts/check-landing-design.mjs",
    "prepare:lemma-sdk": "npm --prefix ../lemma-typescript run build",
    "predev": "npm run prepare:lemma-sdk",
    "prebuild": "npm run prepare:lemma-sdk",
    "pretypecheck": "npm run prepare:lemma-sdk",
    "pretest": "npm run prepare:lemma-sdk",
    "check": "npm run lint && npm run check:naming && npm run check:design && npm run typecheck"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "@novnc/novnc": "^1.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.90.12",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "lemma-sdk": "file:../lemma-typescript",
    "next": "^16.3.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-qr-code": "^2.2.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "supertokens-web-js": "^0.16.0",
    "three": "^0.186.0",
    "tiptap-markdown": "^0.9.0",
    "unist-util-visit": "^5.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/node": "^26.5.1",
    "@types/novnc__novnc": "^1.6.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
