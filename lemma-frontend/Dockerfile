# syntax=docker/dockerfile:1

# Kept in step with /.nvmrc and both package.json `engines`. This image is
# what actually ships the frontend, and it was two majors ahead of every CI
# job that validates it -- so production ran a Node nothing had tested.
FROM node:26-alpine AS builder

WORKDIR /lemma-typescript
COPY lemma-typescript/package.json lemma-typescript/package-lock.json ./
RUN npm ci
COPY lemma-typescript/ ./
RUN npm run build

WORKDIR /app
COPY lemma-frontend/package.json lemma-frontend/package-lock.json ./
RUN npm ci
COPY lemma-frontend/ ./

# The ONLY two NEXT_PUBLIC_* values that must exist at BUILD time.
#
# Everything else the frontend reads is injected at run time through
# `window.__ENV`, generated by docker-entrypoint.sh -- which is why the runner
# stage below declares those and this stage does not.
#
# These two are different because `next.config.ts` uses them to build the
# `/ingest` rewrites, and Next serialises rewrites into `routes-manifest.json`
# at build. The running server never re-evaluates that function, so setting
# them on a container has no effect at all.
#
# Left unset they fall back to the EU hosts. A deployment whose PostHog project
# is in any other region then proxies every browser event to the wrong cluster,
# where the capture endpoint still answers 200 and the data is discarded --
# while `/flags/` 401s and the remote-config bootstrap 404s. Observed exactly
# that on 2026-08-16: a US project, a correct US key in window.__ENV, backend
# analytics arriving normally, and not one frontend event.
#
# ARG rather than a hardcoded ENV so each deployment picks its own region, and
# so an unset value keeps today's EU behaviour.
ARG NEXT_PUBLIC_ANALYTICS_INGEST_HOST=""
ARG NEXT_PUBLIC_ANALYTICS_ASSETS_HOST=""
ENV NEXT_PUBLIC_ANALYTICS_INGEST_HOST=${NEXT_PUBLIC_ANALYTICS_INGEST_HOST}
ENV NEXT_PUBLIC_ANALYTICS_ASSETS_HOST=${NEXT_PUBLIC_ANALYTICS_ASSETS_HOST}
# Retried because `next/font/google` fetches from fonts.googleapis.com during
# the build, so this step is only as reliable as that request. It has taken down
# six of our last eight release runs -- here on the emulated arm64 build, and in
# the host-pack script, always as "Error while requesting resource" and always
# green on a re-run.
#
# The real fix is to stop reaching for the network mid-build: vendor the eight
# families and use `next/font/local`. That is a typography change, not a
# packaging one.
RUN for attempt in 1 2 3; do \
        npm run build && break; \
        if [ "$attempt" = 3 ]; then echo "next build failed after 3 attempts" >&2; exit 1; fi; \
        echo "next build failed (attempt $attempt/3); retrying in $((attempt * 5))s" >&2; \
        sleep $((attempt * 5)); \
    done

FROM node:26-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=8080
ENV HOSTNAME=0.0.0.0

# Runtime env vars (no build args needed!)
# These are injected at container startup via docker-compose
ENV NEXT_PUBLIC_API_URL=""
ENV NEXT_PUBLIC_AUTH_URL=""
ENV NEXT_PUBLIC_SITE_URL=""
ENV NEXT_PUBLIC_SESSION_TOKEN_DOMAIN=""

EXPOSE 8080

COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/public ./app/public
COPY --from=builder /app/.next/static ./app/.next/static

# Copy entrypoint script for runtime config generation
COPY lemma-frontend/docker-entrypoint.sh ./
RUN chmod +x ./docker-entrypoint.sh

ENTRYPOINT ["./docker-entrypoint.sh"]
