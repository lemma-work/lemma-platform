# Public build-time settings. Use sample for a backend-free demo.
NEXT_PUBLIC_DATA=live
# Required for live data.
NEXT_PUBLIC_API_URL=
# SDK auth origin; defaults to NEXT_PUBLIC_API_URL + /auth.
NEXT_PUBLIC_AUTH_URL=
# NEXT_PUBLIC_APPS_DOMAIN_SUFFIX=apps.example.com

# Server-only voice providers and call router.
GEMINI_API_KEY=
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# OPENAI_API_KEY=

# Empty disables the download button; unset uses the public installer.
# NEXT_PUBLIC_DESKTOP_DOWNLOAD_URL=
