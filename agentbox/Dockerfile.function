# Build context is the monorepo root:
#   docker build -f agentbox/Dockerfile.function -t agentbox-function:dev .
ARG PYTHON_IMAGE=python:3.14-slim
ARG UV_VERSION=0.11.31

FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv-runtime

FROM ${PYTHON_IMAGE} AS python-runtime
ENV UV_PROJECT_ENVIRONMENT=/opt/agentbox-function \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy
COPY --from=uv-runtime /uv /usr/local/bin/uv
COPY agentbox/templates/function-python/pyproject.toml /build/agentbox/templates/function-python/pyproject.toml
COPY agentbox/templates/function-python/uv.lock /build/agentbox/templates/function-python/uv.lock
COPY lemma-python /build/lemma-python
RUN uv sync \
        --project /build/agentbox/templates/function-python \
        --locked \
        --no-dev \
        --no-editable \
    && uv cache clean

FROM ${PYTHON_IMAGE}

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app:/opt/agentbox-function/lib/python3.14/site-packages \
    HOME=/home/appuser \
    PATH=/opt/agentbox-function/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin

RUN apt-get update \
    && apt-get install -y --no-install-recommends bash ca-certificates tini \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 appuser \
    && useradd --uid 10001 --gid 10001 --home-dir /home/appuser --create-home appuser \
    && mkdir -p /app/agentbox/function_runtime \
    && chown -R 10001:10001 /app /home/appuser

COPY --from=python-runtime /opt/agentbox-function /opt/agentbox-function

COPY --chown=10001:10001 agentbox/agentbox/__init__.py /app/agentbox/__init__.py
COPY --chown=10001:10001 agentbox/agentbox/function_runtime /app/agentbox/function_runtime
COPY agentbox/scripts/lemma-function-runtime /usr/local/bin/lemma-function-runtime
RUN chmod 0755 /usr/local/bin/lemma-function-runtime \
    && python -m compileall -q /app/agentbox

WORKDIR /tmp
USER 10001:10001
ENTRYPOINT ["tini", "--"]
CMD ["sleep", "infinity"]
