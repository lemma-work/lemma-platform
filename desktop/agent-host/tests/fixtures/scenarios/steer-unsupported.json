          }
        }
      }
    },
    {
      "await_release": true
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "scripted-session",
          "update": {
            "sessionUpdate": "agent_message_chunk",
            "content": {
              "type": "text",
              "text": "Done."
            }
          }
        }
      }
    }
  ]
}
