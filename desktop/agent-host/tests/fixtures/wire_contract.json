{
  "$comment": [
    "The Agent Host wire contract, asserted from both sides.",
    "",
    "Everything here exists twice, once in Rust and once in Python. Nothing but",
    "this file checks that the copies agree, and a disagreement does not fail",
    "loudly: a value one side sends and the other does not know is an event, a",
    "command or a frame the other side drops on the floor.",
    "",
    "`protocol_version` is `lemma_agent_host::PROTOCOL_VERSION` and",
    "`AGENT_HOST_PROTOCOL_VERSION`.",
    "",
    "`enums` are the wire enums in `protocol.rs` and `domain/agent_host.py`,",
    "compared as sets in both directions.",
    "",
    "`link` is the frame vocabulary and close codes of the WebSocket in",
    "`src/link/protocol.rs` and `domain/agent_host_link.py`; see",
    "docs/architecture/agent-host.md#the-link.",
    "",
    "`text_extraction` is `runtime::chunk_text` and `event_text.event_text`.",
    "The host accumulates streamed text with one and the backend re-accumulates",
    "it with the other; a disagreement silently truncates a persisted message.",
    "",
    "`tool_events` are normalized tool events as the host emits them, and the",
    "conversation message the backend must make of each. The host half is held",
    "to real adapter output by the golden transcripts in fixtures/acp; this half",
    "pins what the backend does with the result. See",
    "docs/architecture/agent-host-events.md."
  ],
  "protocol_version": 3,
  "event_types": [
    "run_state",
    "agent_message_chunk",
    "agent_message_upsert",
    "agent_thought_chunk",
    "agent_thought_upsert",
    "tool_call",
    "tool_call_progress",
    "tool_call_result",
    "usage",
    "session_update",
    "config_update",
    "permission_request",
    "terminal"
  ],
  "text_extraction": [
    {
      "name": "a plain text field",
      "payload": {
        "text": "hello"
      },
      "text": "hello"
    },
    {
      "name": "a delta field when there is no text",
      "payload": {
        "delta": "hello"
      },
      "text": "hello"
    },
    {
      "name": "text wins over delta",
      "payload": {
        "text": "kept",
        "delta": "ignored"
      },
      "text": "kept"
    },
    {
      "name": "content as a bare string",
      "payload": {
        "content": "hello"
      },
      "text": "hello"
    },
    {
      "name": "content as a text block",
      "payload": {
        "content": {
          "type": "text",
          "text": "hello"
        }
      },
      "text": "hello"
    },
    {
      "name": "an image block carries no text",
      "payload": {
        "content": {
          "type": "image",
          "data": "aGk=",
          "mimeType": "image/png"
        }
      },
      "text": ""
    },
    {
      "name": "a content list is not walked",
      "payload": {
        "content": [
          {
            "type": "text",
            "text": "hello"
          }
        ]
      },
      "text": ""
    },
    {
      "name": "a non-string text field is not text",
      "payload": {
        "text": 5
      },
      "text": ""
    },
    {
      "name": "a non-string text field still falls through to delta",
      "payload": {
        "text": 5,
        "delta": "hello"
      },
      "text": "hello"
    },
    {
      "name": "an empty payload",
      "payload": {},
      "text": ""
    },
    {
      "name": "an unrelated payload",
      "payload": {
        "status": "COMPLETED",
        "toolCallId": "c1"
      },
      "text": ""
    }
  ],
  "limits": {
    "_why": "Bounds the backend enforces on the wire. A host that exceeds one of these does not degrade: an over-long object_id gets its batch refused and the transcript discarded, and an over-large max_runs makes every poll 422 so the host reports itself offline for ever.",
    "object_id_max_length": 255,
    "max_runs": 128
  },
  "run_spec": {
    "_why": "The START_RUN payload is a run spec in two languages, and only one of them declares every field. `mcp` is on the wire but is deliberately not a field of the Python model: it rests in the command row as `encrypted_mcp` and `_wire_command` decrypts it into `mcp` as the command is handed to the host, so a model field would be somewhere a run-scoped credential could be persisted in plaintext. Nothing tied the two field lists together, which made that deliberate absence indistinguishable from a field somebody forgot -- and made adding a field on one side and not the other invisible until a run behaved oddly.",
    "fields": [
      "agent_run_id",
      "conversation_id",
      "harness_id",
      "profile_revision",
      "model_name",
      "config_selections",
      "system_prompt",
      "prompt",
      "resume_session_id",
      "workspace_cwd",
      "context",
      "run_deadline",
      "system_prompt_delivery"
    ],
    "added_on_delivery": {
      "mcp": "Run-scoped Lemma MCP configuration, decrypted from `encrypted_mcp` by AgentHostDispatchRepository._wire_command when the command is delivered."
    }
  },
  "enums": {
    "run_state": [
      "QUEUED_FOR_HOST",
      "LEASED",
      "ACCEPTED",
      "DISPATCHING",
      "RUNNING",
      "RECOVERING",
      "WAITING_INPUT",
      "SUCCEEDED",
      "FAILED",
      "CANCELLED",
      "DISPATCH_UNKNOWN"
    ],
    "host_status": [
      "ONLINE",
      "OFFLINE",
      "DRAINING",
      "UPGRADE_REQUIRED",
      "REVOKED"
    ],
    "harness_health": [
      "READY",
      "AUTH_REQUIRED",
      "UNSUPPORTED_VERSION",
      "CONFIG_INVALID",
      "PROBE_FAILED",
      "INSTALLING",
      "DISABLED"
    ],
    "rejection_code": [
      "DRAINING",
      "COMMAND_EXPIRED",
      "HARNESS_NOT_FOUND",
      "CONFIG_REVISION_STALE",
      "CAPACITY_LOST",
      "ADAPTER_UNAVAILABLE",
      "INVALID_COMMAND"
    ],
    "command_kind": [
      "START_RUN",
      "CANCEL_RUN",
      "RESOLVE_PERMISSION",
      "REFRESH_CREDENTIAL"
    ],
    "tool_source": [
      "native",
      "lemma",
      "mcp"
    ],
    "tool_status": [
      "completed",
      "failed",
      "cancelled",
      "denied"
    ]
  },
  "link": {
    "path": "/agent-host/link",
    "heartbeat_ms": 20000,
    "host_frames": [
      "pair",
      "hello",
      "control",
      "events",
      "harnesses",
      "mcp",
      "interaction_wait",
      "revoke",
      "error"
    ],
    "server_frames": [
      "paired",
      "welcome",
      "control_ok",
      "events_ok",
      "harnesses_ok",
      "mcp_ok",
      "interaction_ok",
      "revoked",
      "commands",
      "reconnect",
      "error"
    ],
    "close_codes": {
      "normal": 1000,
      "restarting": 1012,
      "protocol_violation": 4400,
      "revoked_or_missing": 4401,
      "invalid_credential": 4403,
      "heartbeat_timeout": 4408,
      "superseded": 4409,
      "upgrade_required": 4426
    },
    "error_codes": [
      "INVALID_FRAME",
      "NOT_FOUND",
      "STALE_LEASE",
      "SEQUENCE_GAP",
      "TERMINAL_RUN",
      "UNAUTHORIZED",
      "UNAVAILABLE",
      "INTERNAL"
    ]
  },
  "tool_events": [
    {
      "name": "a Lemma MCP call arrives stripped of its namespace",
      "events": [
        {
          "type": "tool_call",
          "object_id": "call-1",
          "payload": {
            "tool": {
              "name": "display_resource",
              "source": "lemma",
              "server": null,
              "title": "lemma_display_resource",
              "kind": "other"
            },
            "input": {
              "type": "WIDGET",
              "content": "<div>hello</div>"
            },
            "parent_call_id": null
          }
        },
        {
          "type": "tool_call_result",
          "object_id": "call-1",
          "payload": {
            "status": "completed",
            "output": {
              "success": true,
              "url": "https://x/y"
            },
            "error": null
          }
        }
      ],
      "tool_name": "display_resource",
      "tool_args": {
        "type": "WIDGET",
        "content": "<div>hello</div>"
      },
      "tool_result": {
        "success": true,
        "url": "https://x/y"
      }
    },
    {
      "name": "a native shell command keeps its exit code and output",
      "events": [
        {
          "type": "tool_call",
          "object_id": "exec-1",
          "payload": {
            "tool": {
              "name": "exec_command",
              "source": "native",
              "server": null,
              "title": "echo hello-lemma",
              "kind": "execute"
            },
            "input": {
              "cmd": "echo hello-lemma",
              "workdir": "/workspace/fixture"
            },
            "parent_call_id": null
          }
        },
        {
          "type": "tool_call_result",
          "object_id": "exec-1",
          "payload": {
            "status": "completed",
            "output": {
              "exit_code": 0,
              "stdout": "hello-lemma\n"
            },
            "error": null
          }
        }
      ],
      "tool_name": "exec_command",
      "tool_args": {
        "cmd": "echo hello-lemma",
        "workdir": "/workspace/fixture"
      },
      "tool_result": {
        "exit_code": 0,
        "stdout": "hello-lemma\n"
      }
    },
    {
      "name": "a failed call keeps its output and says why",
      "events": [
        {
          "type": "tool_call",
          "object_id": "exec-2",
          "payload": {
            "tool": {
              "name": "exec_command",
              "source": "native",
              "server": null,
              "title": "false",
              "kind": "execute"
            },
            "input": {
              "cmd": "false"
            },
            "parent_call_id": null
          }
        },
        {
          "type": "tool_call_result",
          "object_id": "exec-2",
          "payload": {
            "status": "failed",
            "output": {
              "exit_code": 1,
              "stderr": "boom"
            },
            "error": "exited with code 1"
          }
        }
      ],
      "tool_name": "exec_command",
      "tool_args": {
        "cmd": "false"
      },
      "tool_result": {
        "exit_code": 1,
        "stderr": "boom",
        "success": false,
        "error": "exited with code 1"
      }
    }
  ]
}
