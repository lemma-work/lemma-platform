{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "control-capability",
  "description": "Bundled Local settings child webview with narrowly checked application commands. Every command here is additionally guarded in Rust by require_control_window, which re-checks the webview label and that its URL is a trusted packaged asset.",
  "webviews": [
    "control"
  ],
  "permissions": [
    "core:default",
    "allow-start",
    "allow-stop",
    "allow-restart",
    "allow-open-app",
    "allow-open-logs",
    "allow-diagnostic-logs",
    "allow-runtime-info",
    "allow-repair-runtime",
    "allow-control-snapshot",
    "allow-agent-host-action",
    "allow-apply-operator-config",
    "allow-discover-provider-models",
    "allow-configure-ai-provider",
    "allow-sharing-action",
    "allow-close-local-settings",
    "allow-confirm-destructive-action",
    "allow-open-developer-tools",
    "allow-local-recovery-options",
    "allow-reset-local-data",
    "allow-reset-full-reinstall",
    "allow-restart-into-recovery",
    "allow-check-for-app-update",
    "allow-install-app-update"
  ]
}
