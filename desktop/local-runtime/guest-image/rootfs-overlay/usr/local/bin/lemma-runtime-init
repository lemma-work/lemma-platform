#!/bin/sh
set -eu

# WSL does not need a persistent guest RPC daemon: the signed Windows bridge
# invokes lemma-guestd request inside this private distribution. It does need
# one durable containerd instance. VZ boots through systemd instead.
# /etc/fstab is not read here -- see /etc/wsl.conf -- so the tmpfs the guest
# expects at /tmp is mounted from the one place WSL does run. Everything that
# writes scratch files does so under it, and it is noexec and bounded, which
# is the point of having it rather than the root filesystem.
if ! /usr/bin/mountpoint -q /tmp; then
  mount -t tmpfs -o rw,nosuid,nodev,noexec,mode=1777,size=512m tmpfs /tmp
fi

# Lemma's durable trees, before anything that writes to them.
#
# This distribution is replaced wholesale on every upgrade -- `wsl --import`
# over a new rootfs -- so nothing that must survive one may live inside it. It
# lives in a second distribution instead, which publishes it into the WSL VM's
# shared namespace at this path; see `ensure_data_distribution` on the host.
# There is no second disk to attach here the way macOS attaches one: `wsl
# --mount --vhd` needs administrator rights, and Lemma does not ask for them.
#
# Failing here is the point. Continuing without it would put workspaces,
# databases and volumes inside a distribution the next upgrade throws away,
# and every run before that upgrade would look perfectly healthy.
# A mountpoint, not a directory. `/mnt/wsl` is a tmpfs, so a publish that
# created the path and then failed to bind leaves an ordinary directory on
# throwaway storage -- and binding /var/lib/lemma from there would satisfy
# every check below while putting the data somewhere the VM discards.
LEMMA_DATA_SHARE=/mnt/wsl/lemma-data
if ! /usr/bin/mountpoint -q "$LEMMA_DATA_SHARE"; then
  printf 'lemma-data: needs-repair: %s was not published by the data distribution\n' \
    "$LEMMA_DATA_SHARE"
  exit 1
fi
/usr/local/bin/lemma-bind-data "$LEMMA_DATA_SHARE"

mkdir -p /run/containerd /var/lib/containerd /var/log/lemma
if ! /usr/bin/ctr --address /run/containerd/containerd.sock version >/dev/null 2>&1; then
  nohup /usr/bin/containerd \
    >>/var/log/lemma/containerd.log 2>&1 </dev/null &
fi

attempt=0
until /usr/bin/ctr --address /run/containerd/containerd.sock version >/dev/null 2>&1; do
  attempt=$((attempt + 1))
  if [ "$attempt" -ge 120 ]; then
    echo "containerd did not become ready" >&2
    exit 1
  fi
  sleep 1
done
