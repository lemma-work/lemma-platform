[Unit]
Description=Mount Lemma's private persistent data disk
DefaultDependencies=no
ConditionPathExists=/dev/vdb
After=dev-vdb.device local-fs.target
Requires=dev-vdb.device
Before=containerd.service lemma-guestd.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/lemma-mount-data
RemainAfterExit=yes

[Install]
WantedBy=lemma-runtime.target
