# Lemma self-hosted configuration.
#
# `./bootstrap.sh` writes a .env from this file, filling in the values marked
# GENERATED. Copy it by hand instead if you would rather fill them in yourself.
#
# This file holds what a deployment must decide. It is not the full list of
# settings — docs/configuration.md documents every operator-facing one, and
# anything you add here reaches the API, worker and migration containers.
#
# Anything secret in here is secret: the database password and the encryption
# keys are the deployment. Keep the file at mode 600 and out of version control.

# ── Ingress ───────────────────────────────────────────────────────────────────
# Turns on the bundled Caddy. Comment it out to run behind your own load
# balancer or ingress controller — see "Bring your own load balancer" in
# docs/self-hosting.md.
COMPOSE_PROFILES=caddy

# The hostname people type. bootstrap.sh defaults this to <public-ip>.sslip.io,
# which resolves to this machine without you owning a domain or editing DNS.
LEMMA_DOMAIN=GENERATED

# The API is served on this port of LEMMA_DOMAIN — the same hostname as the UI,
# not api.<domain>. That is what lets the session cookie be host-only, so pod
# apps on *.apps.<domain> never receive it. Changing this to 443 would collide
# with the UI; changing it to anything else is fine.
LEMMA_API_PORT=8443

# `internal` uses Caddy's own certificate authority: no rate limits, no DNS, no
# network, and a browser warning on first visit. It is the default because it
# always works.
#
# Put a real email here to get publicly trusted Let's Encrypt certificates
# instead, and set LEMMA_APPS_TLS_OPTS=on_demand so each pod app subdomain gets
# its own certificate as it is first loaded. That needs LEMMA_DOMAIN to be a
# domain you control, with an A record for it and a wildcard A record for
# *.apps.<domain>, both pointing here, and ports 80 and 443 reachable from the
# internet.
#
# Do not point this at an sslip.io or nip.io name. Those share one Let's
# Encrypt quota across every user of the service, and it is routinely exhausted.
LEMMA_TLS_ARG=internal
LEMMA_APPS_TLS_OPTS=

# Largest request body the proxy will accept — file uploads into a datastore
# are the reason this is not small.
LEMMA_MAX_UPLOAD=512MB

# ── Images ────────────────────────────────────────────────────────────────────
# Written by bootstrap.sh from the release manifest that lemma-stack and Lemma
# Desktop also install from, so a compose deployment and a desktop install of
# the same version run the same bytes.
#
# The two sandbox images MUST stay pinned by @sha256 digest: the workspace
# provider refuses a tag-only reference unless
# WORKSPACE_DOCKER_ALLOW_MUTABLE_IMAGES is on, because a moving tag means the
# image that ran is not the image that was reviewed.
LEMMA_BACKEND_IMAGE=GENERATED
LEMMA_FRONTEND_IMAGE=GENERATED
WORKSPACE_IMAGE=GENERATED
FUNCTION_IMAGE=GENERATED
LEMMA_POSTGRES_IMAGE=GENERATED
LEMMA_REDIS_IMAGE=GENERATED
LEMMA_SUPERTOKENS_IMAGE=GENERATED
LEMMA_CADDY_IMAGE=caddy:2-alpine
LEMMA_DOCKER_CLI_IMAGE=docker:29-cli

# ── Runtime ───────────────────────────────────────────────────────────────────
ENVIRONMENT=GENERATED

# The source commit the images were built from. `production` refuses to start
# without a valid one, because a deployment that cannot say which build it is
# running cannot be debugged from its own logs. bootstrap.sh takes it from the
# release manifest; releases published before that field existed have none, and
# bootstrap falls back to ENVIRONMENT=development for them.
LEMMA_RELEASE_SHA=GENERATED

# Not a verbosity setting. True makes every unhandled error answer with a source
# annotated stack trace instead of the error envelope every client parses, so
# the backend refuses to start with it on outside local mode.
DEBUG=false
LOG_LEVEL=INFO
JSON_LOGS_ENABLED=true
# /docs, /scalar and /openapi.json. Off by default; each costs a few seconds of
# every cold start and nothing but a human reads them.
API_DOCS_ENABLED=false

# ── Data ──────────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=GENERATED
DATABASE_URL=GENERATED
DATASTORE_DATABASE_URL=GENERATED
REDIS_URL=redis://redis:6379
SUPERTOKENS_CORE_URL=http://supertokens:3567

# Files and objects on the local disk, in Docker volumes. Switch to S3, GCS or
# Azure with STORAGE_BACKEND — see lemma-backend/docs/operators/object-storage.md.
STORAGE_BACKEND=local
LOCAL_OBJECT_STORAGE_ROOT=/app/.local/object-storage
LOCAL_FILE_STORAGE_ROOT=/app/.local/files

# ── URLs and cookies ──────────────────────────────────────────────────────────
# Written by bootstrap.sh from LEMMA_DOMAIN. Edit these directly if your load
# balancer publishes different names.
API_URL=GENERATED
FRONTEND_URL=GENERATED
AUTH_FRONTEND_URL=GENERATED
CLI_API_URL=GENERATED
CLI_AUTH_FRONTEND_URL=GENERATED
AUTH_WEBSITE_BASE_PATH=/auth
SUPERTOKENS_API_BASE_PATH=/auth
SUPERTOKENS_API_GATEWAY_PATH=/st

# Pod apps are served at <slug>.<APP_BASE_DOMAIN>, by the API itself. Required:
# the backend refuses to start without it outside local mode, because there is
# no safe default for somebody else's domain.
APP_BASE_DOMAIN=GENERATED

# Blank on purpose, and this is the one line here worth understanding.
#
# Blank gives a host-only session cookie, set on LEMMA_DOMAIN alone. The UI and
# the API share that hostname on two ports, and ports are not part of cookie
# host matching, so both get the cookie. Pod apps are on *.apps.<domain> — a
# different host — so they never do.
#
# Setting this to .<domain> would make the session cookie reach every pod app,
# and pod apps serve HTML that people in your organization wrote. Leave it
# blank unless you have moved apps to a separate registrable domain.
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=lax

# FRONTEND_URL and AUTH_FRONTEND_URL are always allowed CORS origins, and app
# subdomains are derived from APP_BASE_DOMAIN, so CORS_ORIGINS is left unset.
# Add one only for another first-party origin that calls the API with cookies.

# ── Secrets ───────────────────────────────────────────────────────────────────
# Encrypts connector credentials, auth-config payloads and runtime-profile
# credentials at rest. Lose it and those rows are unreadable; leak it and they
# are plaintext. Back it up with the database, not separately from it.
SECRET_ENCRYPTION_KEY=GENERATED

# Signs the per-container token the in-sandbox runtime accepts. Nothing can be
# provisioned without it.
WORKSPACE_RUNTIME_CREDENTIAL_KEY=GENERATED

# ── Sandboxes ─────────────────────────────────────────────────────────────────
# Agents, functions and workflows all run in sandboxes, so this is not optional
# for a working deployment.
#
# `docker` provisions them on this machine's own Docker daemon, which is why the
# api and worker containers mount the Docker socket. That is real privilege —
# read "What the Docker socket means" in docs/self-hosting.md before deciding
# it is fine.
#
# `e2b` rents them instead, and is the answer on a platform with no Docker
# socket to give (Railway, Render, App Platform). Set E2B_API_KEY and
# E2B_METADATA_NAMESPACE if you use it.
WORKSPACE_PROVIDER=docker
WORKSPACE_DOCKER_SOCKET_PATH=/var/run/docker.sock
# Sandboxes join this network, which does NOT carry Postgres or Redis.
WORKSPACE_DOCKER_PRIVATE_NETWORK=lemma-sandbox
WORKSPACE_DOCKER_ALLOW_MUTABLE_IMAGES=false
WORKSPACE_ADD_HOST_GATEWAY=false
# How a sandbox reaches the API: over the shared container network, by service
# name. Not the public URL — that would leave the machine and come back, and
# with LEMMA_TLS_ARG=internal the sandbox would not trust the certificate.
WORKSPACE_CALLBACK_API_URL=http://api:8000
FUNCTION_RUNTIME_GATEWAY_URL=http://api:8000
# E2B_API_KEY=
# E2B_METADATA_NAMESPACE=

# ── Email ─────────────────────────────────────────────────────────────────────
# Sign-up verification, invitations and password resets. `filesystem` writes
# messages to disk instead of sending them, which is fine for a trial and wrong
# for anything with more than one person in it.
#
# See docs/authentication-hardening.md for the full set, including Resend.
EMAIL_TRANSPORT=filesystem
EMAIL_OUTPUT_DIR=/app/.local/emails
# EMAIL_TRANSPORT=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=Lemma
# SMTP_USE_TLS=true

# Requires a working transport above. Left off so a trial install is not locked
# out of its own first account; turn it on once email sends.
AUTH_EMAIL_VERIFICATION_REQUIRED=false

# ── Models ────────────────────────────────────────────────────────────────────
# Agents need one. Any OpenAI-compatible or Anthropic-compatible endpoint: a
# cloud provider, your own gateway, or a local model.
LEMMA_DEFAULT_MODEL_TYPE=openai_compat
LEMMA_OPENAI_API_KEY=
LEMMA_OPENAI_BASE_URL=https://api.openai.com/v1
LEMMA_OPENAI_DEFAULT_MODEL=
LEMMA_OPENAI_MODEL_NAMES=
LEMMA_OPENAI_VISION_MODEL_NAMES=
# LEMMA_DEFAULT_MODEL_TYPE=anthropic_compat
# LEMMA_ANTHROPIC_API_KEY=
# LEMMA_ANTHROPIC_DEFAULT_MODEL=
# LEMMA_ANTHROPIC_MODEL_NAMES=

# Embeddings for search and datastore indexing.
#
# `auto` uses the model endpoint above when you have given it a key, and falls
# back to a local model otherwise. Prefer it: forcing `local` on a deployment
# that already has a perfectly good embedding endpoint makes both the api and
# the worker download a ~210 MB model from HuggingFace before they will serve.
#
# That download is unauthenticated and, on the path huggingface_hub takes by
# default, has no timeout: it stops at "Fetching 5 files: 0%" and stays there.
# Measured on a first boot here — two attempts, over an hour each, zero bytes
# written and not one line in the log. Set HF_TOKEN as well if you hit the
# anonymous rate limit. The model is cached in a volume, so this is a
# first-start cost per service, not a per-restart one.
EMBEDDING_PROVIDER=auto

# Moves that download off HuggingFace's Xet storage onto its plain CDN.
#
# Default-on because of what the two paths do when the network is unhappy. Xet
# hung silently, indefinitely, with the api stuck in "Waiting for application
# startup." and nothing to read. The CDN path, on the same machine and the same
# minute, reported "read operation timed out", resumed, and finished. A slower
# transfer that says what is wrong beats a faster one that cannot.
#
# Unset it if you would rather have Xet's speed and have a link that likes it.
HF_HUB_DISABLE_XET=1
WEB_SEARCH_PROVIDER=duckduckgo
DOCUMENT_PROCESSOR=xberg

# ── Chat surfaces ─────────────────────────────────────────────────────────────
# A deployment with a public HTTPS URL should receive Telegram and Slack events
# by webhook. Both of these are the fallback for one that cannot, and they are
# no-ops until a token is set.
ENABLE_TELEGRAM_POLLING_MODE=false
ENABLE_SLACK_SOCKET_MODE=false
