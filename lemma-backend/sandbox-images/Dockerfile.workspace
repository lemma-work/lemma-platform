# Build context is the monorepo root:
#   docker build -f lemma-backend/sandbox-images/Dockerfile.workspace -t lemma-workspace:dev .
# NOTE ON NAMING: the paths and env vars here (/opt/lemma-python,
# /run/lemma-bootstrap, LEMMA_RUNTIME_TOKEN_FILE) are the contract between a
# *running* sandbox and the backend that delivers its credential, not cosmetic
# detail. Changing one requires every existing sandbox to be recreated, which
# is what the profile digest is for: a sandbox is only reused when its recorded
# digest matches the configured one, so bumping the digest in the same release
# as an image change is what makes a rename here safe.

ARG PYTHON_IMAGE=python:3.14.6-slim
ARG NODE_IMAGE=node:24.18.0-slim
ARG UV_VERSION=0.11.31
ARG PNPM_VERSION=11.15.1
ARG GH_VERSION=2.97.0

FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv-runtime

# The GitHub CLI is not in Debian, and an agent working in a repo reaches for
# `gh` as readily as `git` -- issues, PRs and releases have no plumbing
# equivalent. Pinned and checksummed like Node above, because this fetches a
# binary over the network at build time.
FROM ${PYTHON_IMAGE} AS gh-runtime
ARG GH_VERSION
ARG TARGETARCH
# The slim base has no curl; the final stage installs its own.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*
RUN set -eu; \
    runtime_arch="${TARGETARCH:-$(dpkg --print-architecture)}"; \
    case "${runtime_arch}" in \
        amd64) gh_sha=a2c9b8497e1f85b1ad0dfcb78b5a622e098801b8e461e459e88e1ee12f018112 ;; \
        arm64) gh_sha=73ea440ecad9c9e284429997ee6f93577bc6f7bc6fba357ef62c53ad8fb641a5 ;; \
        *) echo "unsupported GitHub CLI architecture: ${runtime_arch}" >&2; exit 1 ;; \
    esac; \
    archive="gh_${GH_VERSION}_linux_${runtime_arch}.tar.gz"; \
    curl -fsSL "https://github.com/cli/cli/releases/download/v${GH_VERSION}/${archive}" \
        -o /tmp/gh.tar.gz; \
    echo "${gh_sha}  /tmp/gh.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/gh.tar.gz -C /tmp; \
    install -m 0755 "/tmp/gh_${GH_VERSION}_linux_${runtime_arch}/bin/gh" /usr/local/bin/gh; \
    rm -rf /tmp/gh.tar.gz "/tmp/gh_${GH_VERSION}_linux_${runtime_arch}"

FROM ${NODE_IMAGE} AS node-runtime
ARG PNPM_VERSION
ARG TARGETARCH
WORKDIR /opt/lemma-node
RUN corepack enable pnpm \
    && corepack prepare "pnpm@${PNPM_VERSION}" --activate
COPY lemma-backend/sandbox-images/templates/workspace-node/package.json ./package.json
COPY lemma-backend/sandbox-images/templates/workspace-node/pnpm-lock.yaml ./pnpm-lock.yaml
COPY lemma-backend/sandbox-images/templates/workspace-node/pnpm-workspace.yaml ./pnpm-workspace.yaml
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --prod --frozen-lockfile \
    && runtime_arch="${TARGETARCH:-$(dpkg --print-architecture)}" \
    && case "${runtime_arch}" in \
        amd64) browser_binary=agent-browser-linux-x64 ;; \
        arm64) browser_binary=agent-browser-linux-arm64 ;; \
        *) echo "unsupported Agent Browser architecture: ${runtime_arch}" >&2; exit 1 ;; \
       esac \
    && browser_bin_dir="$(find node_modules/.pnpm -type d -path '*/node_modules/agent-browser/bin' -print -quit)" \
    && test -n "${browser_bin_dir}" \
    && find "${browser_bin_dir}" -maxdepth 1 -type f -name 'agent-browser-*' \
        ! -name "${browser_binary}" -delete \
    && chmod 0755 "${browser_bin_dir}/${browser_binary}" \
    && pnpm store prune

FROM ${PYTHON_IMAGE} AS python-runtime
ENV UV_PROJECT_ENVIRONMENT=/opt/lemma-python \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy
COPY --from=uv-runtime /uv /usr/local/bin/uv
COPY lemma-backend/sandbox-images/templates/workspace-python/pyproject.toml /build/lemma-backend/sandbox-images/templates/workspace-python/pyproject.toml
COPY lemma-backend/sandbox-images/templates/workspace-python/uv.lock /build/lemma-backend/sandbox-images/templates/workspace-python/uv.lock
COPY lemma-python /build/lemma-python
COPY lemma-pod-bundle /build/lemma-pod-bundle
COPY lemma-cli /build/lemma-cli
COPY lemma-skills /build/lemma-skills
RUN uv sync \
        --project /build/lemma-backend/sandbox-images/templates/workspace-python \
        --locked \
        --no-dev \
        --no-editable \
    && printf '%s\n' \
        'import sys; p="/workspace/.python/lib/python3.14/site-packages"; sys.path.insert(0, p) if p not in sys.path else None' \
        > /opt/lemma-python/lib/python3.14/site-packages/lemma-workspace-overlay.pth \
    && uv cache clean

FROM ${PYTHON_IMAGE}

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_PREFIX=/workspace/.python \
    PYTHONPATH=/app:/workspace/.python/lib/python3.14/site-packages:/opt/lemma-python/lib/python3.14/site-packages \
    HOME=/home/appuser \
    DISPLAY=:99 \
    XDG_RUNTIME_DIR=/tmp/lemma-browser/runtime \
    WORKSPACE_XVFB_SCREEN=1440x960x24 \
    AGENT_BROWSER_CONFIG=/tmp/lemma-browser/config.json \
    AGENT_BROWSER_DASHBOARD_PORT=4848 \
    AGENT_BROWSER_DASHBOARD_INTERNAL_PORT=4849 \
    AGENT_BROWSER_EXECUTABLE_PATH=/usr/local/bin/workspace-chrome \
    AGENT_BROWSER_PROFILE=/tmp/lemma-browser/profile \
    AGENT_BROWSER_SESSION=workspace \
    AGENT_BROWSER_HEADED=true \
    LEMMA_RUNTIME_TOKEN_FILE=/run/lemma-bootstrap/token \
    LEMMA_SANDBOX_PROCESS_NAMESPACE=isolated \
    GH_CONFIG_DIR=/tmp/lemma-gh \
    GH_NO_UPDATE_NOTIFIER=1 \
    GH_PAGER=cat \
    NODE_PATH=/opt/lemma-node/node_modules \
    # On the workspace volume, which is the only thing that survives a sandbox
    # being recreated — and, less obviously, the only place pnpm can do its job.
    # pnpm links packages into node_modules from its store, and a hard link
    # cannot cross a filesystem: with the store on the container layer and the
    # project on /workspace, every install silently fell back to copying. So the
    # store was neither faster nor smaller than npm's. Here it is both, and it
    # survives to the next conversation.
    PNPM_HOME=/workspace/.pnpm \
    UV_CACHE_DIR=/workspace/.uv-cache \
    PATH=/workspace/.python/bin:/workspace/.pnpm:/opt/lemma-python/bin:/opt/lemma-node/node_modules/.bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin \
    MPLBACKEND=Agg

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        chromium \
        curl \
        fonts-dejavu-core \
        fonts-liberation \
        git \
        libasound2t64 \
        libatk-bridge2.0-0t64 \
        libatk1.0-0t64 \
        libatomic1 \
        libatspi2.0-0t64 \
        libcairo2 \
        libcups2t64 \
        libnspr4 \
        libnss3 \
        libpango-1.0-0 \
        libxcomposite1 \
        libxdamage1 \
        libxkbcommon0 \
        procps \
        ripgrep \
        socat \
        tini \
        xvfb \
    && rm -rf /var/lib/apt/lists/*

COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
# npm and npx, not just the node binary. Copying only `node` left the image with
# pnpm and no npm at all, which breaks the first thing anyone does with a
# JavaScript project: `npx create-next-app`, `npm install`, `npm run build`, and
# every README and error message that names them. An agent asked to build a
# Next.js app got as far as discovering npm was missing and started hand-
# downloading a Node tarball — twice, because it guessed the wrong architecture.
# pnpm stays the preferred installer; npm just has to exist.
COPY --from=node-runtime /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
COPY --from=node-runtime /opt/lemma-node /opt/lemma-node
COPY --from=python-runtime /opt/lemma-python /opt/lemma-python
COPY --from=uv-runtime /uv /usr/local/bin/uv
COPY --from=uv-runtime /uvx /usr/local/bin/uvx
COPY --from=gh-runtime /usr/local/bin/gh /usr/local/bin/gh
COPY lemma-backend/sandbox-images/scripts/lemma-node-tool /usr/local/lib/lemma-node-tool
RUN ln -sf "$(command -v chromium)" /usr/local/bin/workspace-chrome \
    && ln -sf ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -sf ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && ln -sf /opt/lemma-python/bin/lemma /usr/local/bin/lemma \
    && chmod 0755 /usr/local/lib/lemma-node-tool \
    && ln -sf /usr/local/lib/lemma-node-tool /usr/local/bin/agent-browser \
    && ln -sf /usr/local/lib/lemma-node-tool /usr/local/bin/lit \
    && ln -sf /usr/local/lib/lemma-node-tool /usr/local/bin/liteparse \
    && ln -sf /usr/local/lib/lemma-node-tool /usr/local/bin/pnpm

RUN groupadd --gid 10001 appuser \
    && useradd --uid 10001 --gid 10001 --home-dir /home/appuser --create-home appuser \
    && mkdir -p \
        /app/sandbox_runtime/api \
        /app/sandbox_runtime/workspace \
        /workspace \
        /run/lemma-bootstrap \
        /tmp/.X11-unix \
        /tmp/lemma-browser/runtime \
    && chmod 1777 /tmp/.X11-unix \
    && chown -R 10001:10001 \
        /app \
        /workspace \
        /home/appuser \
        /run/lemma-bootstrap \
        /tmp/lemma-browser \
    && chmod 0700 /run/lemma-bootstrap

COPY lemma-python /sdk/lemma-python
COPY lemma-pod-bundle /sdk/lemma-pod-bundle
COPY lemma-cli /sdk/lemma-cli
COPY lemma-typescript /sdk/lemma-typescript
COPY lemma-skills /sdk/lemma-skills
COPY lemma-backend/sandbox-images/templates/workspace-python/lemma-profile.sh /etc/profile.d/lemma-python.sh
COPY lemma-backend/sandbox-images/templates/workspace-github/lemma-profile.sh /etc/profile.d/lemma-github.sh
RUN chmod -R a+rX /sdk

COPY --chown=10001:10001 lemma-backend/sandbox_runtime/__init__.py /app/sandbox_runtime/__init__.py
COPY --chown=10001:10001 lemma-backend/sandbox_runtime/protocol.py /app/sandbox_runtime/protocol.py
COPY --chown=10001:10001 lemma-backend/sandbox_runtime/tasks.py /app/sandbox_runtime/tasks.py
COPY --chown=10001:10001 lemma-backend/sandbox_runtime/contracts.py /app/sandbox_runtime/contracts.py
COPY --chown=10001:10001 lemma-backend/sandbox_runtime/workspace /app/sandbox_runtime/workspace
COPY lemma-backend/sandbox-images/scripts/start-workspace-runtime.sh /usr/local/bin/start-workspace-runtime
COPY lemma-backend/sandbox-images/scripts/start-browser.sh /usr/local/bin/start-browser
COPY lemma-backend/sandbox-images/scripts/save-webpage.sh /usr/local/bin/save-webpage
COPY lemma-backend/sandbox-images/scripts/webpage-to-markdown.mjs /opt/lemma-node/webpage-to-markdown.mjs
RUN ln -sf /opt/lemma-node/webpage-to-markdown.mjs /usr/local/lib/webpage-to-markdown.mjs
RUN chmod 0755 \
        /usr/local/bin/start-workspace-runtime \
        /usr/local/bin/start-browser \
        /usr/local/bin/save-webpage \
        /usr/local/lib/webpage-to-markdown.mjs \
    && python -m compileall -q /app/sandbox_runtime

WORKDIR /workspace
USER 10001:10001
EXPOSE 8080 4848

ENTRYPOINT ["tini", "--"]
CMD ["start-workspace-runtime"]
