# Build context is the monorepo root:
#   docker build -f lemma-backend/sandbox-images/Dockerfile.function -t lemma-function:dev .
# NOTE ON NAMING: the paths here (/opt/lemma-function, /opt/lemma-python) are
# the contract between a *running* sandbox and the backend, not cosmetic
# detail. Changing one requires every existing function sandbox to be
# recreated, which is what the profile digest is for: a sandbox is only reused
# when its recorded digest matches FUNCTION_PROFILE_DIGEST, so bumping that in
# the same release as an image change is what makes a rename here safe.
# The workspace image's bootstrap credential does not apply -- a function
# runtime is reached through the gateway and authenticates per invocation.
#
# Rebuilt every release, unlike the workspace image: it bakes
# `sandbox_runtime.function` and no overlay reaches it. The layers are ordered
# so that a release which changed only Lemma's own code changes only the small
# ones at the end, and the build is reproducible (pinned bases,
# `SOURCE_DATE_EPOCH`), so the layers below them come out as the same bytes and
# a machine that has the previous image downloads only the top.

# Pinned by digest, as in `Dockerfile.workspace`, and for its reason.
ARG PYTHON_IMAGE=python:3.14.6-slim@sha256:7bec7ddcddeff7975d6ba9b4be7dd6f6b2f55e7491539145e2978f7f97ce9144
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.11.31@sha256:ecd4de2f060c64bea0ff8ecb182ddf46ba3fcccdc8a60cfdbaf20d1a047d7437

FROM ${UV_IMAGE} AS uv-runtime

# The third-party closure alone; see `Dockerfile.workspace`'s `python-runtime`.
FROM ${PYTHON_IMAGE} AS python-runtime
ARG SOURCE_DATE_EPOCH
ENV UV_PROJECT_ENVIRONMENT=/opt/lemma-function \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy
COPY --from=uv-runtime /uv /usr/local/bin/uv
COPY lemma-backend/sandbox-images/templates/function-python/pyproject.toml /build/lemma-backend/sandbox-images/templates/function-python/pyproject.toml
COPY lemma-backend/sandbox-images/templates/function-python/uv.lock /build/lemma-backend/sandbox-images/templates/function-python/uv.lock
RUN uv sync \
        --project /build/lemma-backend/sandbox-images/templates/function-python \
        --frozen \
        --no-dev \
        --no-editable \
        --no-install-package lemma-sdk \
    && uv cache clean

# The SDK on its own, laid over the closure as a small layer of its own.
# `uv_cache.json` is uv's record of when it built the wheel, so it and its
# `RECORD` line go: they are the only bytes two builds of one source disagree on.
FROM python-runtime AS python-floor
ARG SOURCE_DATE_EPOCH
COPY lemma-python /build/lemma-python
RUN uv lock --locked \
        --project /build/lemma-backend/sandbox-images/templates/function-python \
    && uv pip install \
        --no-deps \
        --python /opt/lemma-function/bin/python \
        --prefix /opt/lemma-function-sdk \
        /build/lemma-python \
    && find /opt/lemma-function-sdk -name uv_cache.json -delete \
    && sed -i '/uv_cache\.json/d' /opt/lemma-function-sdk/lib/python3.14/site-packages/*.dist-info/RECORD \
    && uv cache clean

FROM ${PYTHON_IMAGE}

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app:/opt/lemma-function/lib/python3.14/site-packages \
    HOME=/home/appuser \
    PATH=/opt/lemma-function/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin

# The logs go with the lists: they record when the install ran, which is the
# one thing two builds of the same inputs disagree about.
RUN apt-get update \
    && apt-get install -y --no-install-recommends bash ca-certificates tini \
    && rm -rf /var/lib/apt/lists/* /var/log/apt /var/log/dpkg.log /var/log/alternatives.log \
    && groupadd --gid 10001 appuser \
    && useradd --uid 10001 --gid 10001 --home-dir /home/appuser --create-home appuser \
    && mkdir -p /app/sandbox_runtime/function \
    && chown -R 10001:10001 /app /home/appuser

COPY --from=python-runtime /opt/lemma-function /opt/lemma-function
COPY --from=python-floor /opt/lemma-function-sdk/ /opt/lemma-function/

COPY --chown=10001:10001 lemma-backend/sandbox_runtime/__init__.py /app/sandbox_runtime/__init__.py
COPY --chown=10001:10001 lemma-backend/sandbox_runtime/tasks.py /app/sandbox_runtime/tasks.py
COPY --chown=10001:10001 lemma-backend/sandbox_runtime/function /app/sandbox_runtime/function
COPY --chmod=0755 lemma-backend/sandbox-images/scripts/lemma-function-runtime /usr/local/bin/lemma-function-runtime
# Here rather than at the top of the stage, so the layers above do not key
# their cache on it. Hash-validated bytecode; see `Dockerfile.workspace`.
ARG SOURCE_DATE_EPOCH
RUN python -m compileall -q /app/sandbox_runtime

WORKDIR /tmp
USER 10001:10001
ENTRYPOINT ["tini", "--"]
CMD ["lemma-function-runtime", "serve", "--host", "0.0.0.0", "--port", "8090"]
