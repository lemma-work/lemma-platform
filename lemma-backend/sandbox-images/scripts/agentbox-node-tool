#!/usr/bin/env bash
set -euo pipefail

if [ -n "${AGENTBOX_NODE_BINARY:-}" ]; then
  NODE_BINARY="$AGENTBOX_NODE_BINARY"
elif [ -x /opt/node24/bin/node ]; then
  NODE_BINARY="/opt/node24/bin/node"
else
  NODE_BINARY="node"
fi
NODE_PROJECT="${AGENTBOX_NODE_PROJECT:-/opt/agentbox-node}"
tool="$(basename "$0")"

case "$tool" in
  agent-browser)
    pattern='*/node_modules/agent-browser/bin/agent-browser.js'
    ;;
  lit|liteparse)
    pattern='*/node_modules/@llamaindex/liteparse/dist/cli.js'
    ;;
  pnpm)
    pattern='*/node_modules/pnpm/bin/pnpm.mjs'
    ;;
  *)
    echo "unsupported AgentBox Node tool: $tool" >&2
    exit 64
    ;;
esac

entrypoint="$(
  find "$NODE_PROJECT/node_modules/.pnpm" -path "$pattern" -print -quit
)"
if [ -z "$entrypoint" ]; then
  echo "AgentBox Node tool is not installed: $tool" >&2
  exit 127
fi

exec "$NODE_BINARY" "$entrypoint" "$@"
