#!/usr/bin/env bash
set -euo pipefail

if [ -n "${LEMMA_NODE_BINARY:-}" ]; then
  NODE_BINARY="$LEMMA_NODE_BINARY"
elif [ -x /opt/node24/bin/node ]; then
  NODE_BINARY="/opt/node24/bin/node"
else
  NODE_BINARY="node"
fi
NODE_PROJECT="${LEMMA_NODE_PROJECT:-/opt/lemma-node}"
tool="$(basename "$0")"

# Bring the browser up before a command that needs it.
#
# `start-browser` is what writes the config and starts Xvfb, and the skill says
# to call it first. An agent that goes straight for `agent-browser` instead --
# the obvious thing to type, and what a model does when it has used this CLI
# anywhere else -- got one of two errors, neither of which names the remedy:
#
#     ⚠ config file not found: /tmp/lemma-browser/config.json
#     Missing X server or $DISPLAY
#
# Both mean "start-browser has not run". Neither says so, so the reasonable
# conclusion from inside the sandbox is that the browser tooling is broken, and
# the fallback an agent reaches for is downloading Playwright and its own
# Chromium -- into a 2 GB sandbox, to do what the installed browser already
# does. Observed in a real transcript; this is the fix.
#
# Ordering stops being something the caller has to know. Info-only flags are
# left alone so `--version` never starts an X server, and the guard variable
# keeps `start-browser`'s own nested calls from coming back through here.
ensure_browser_started() {
  if [ -n "${LEMMA_BROWSER_BOOTSTRAP:-}" ]; then
    return 0
  fi
  case "${1:-}" in
    ""|--version|-v|--help|-h|help)
      return 0
      ;;
  esac
  config="${AGENT_BROWSER_CONFIG:-/tmp/lemma-browser/config.json}"
  display="${DISPLAY:-:99}"
  display_number="${display#:}"
  display_number="${display_number%%.*}"
  # A running X server, not the socket it left behind. `/tmp/.X11-unix/X99` is
  # an ordinary file in the container's writable layer, so it outlives the
  # process that made it whenever Xvfb is killed rather than asked to stop --
  # an ungraceful container stop, a Docker daemon restart, a host reboot, a
  # quiesce that could not reach the runtime, or E2B, which pauses without
  # quiescing and keeps `/tmp`.
  #
  # Testing the socket meant this returned early in exactly those cases, so
  # `start-browser` -- the one thing that would have started Xvfb -- was never
  # called, and every browser command in the sandbox failed with "Missing X
  # server or $DISPLAY" for the life of the container. Fixing the same test
  # inside `start-browser` was not enough on its own, because this guard is
  # what decides whether it runs at all.
  if [ -f "$config" ] && pgrep -f "Xvfb ${display} " >/dev/null 2>&1; then
    return 0
  fi
  command -v start-browser >/dev/null 2>&1 || return 0
  # Its output is the bootstrap's, not the caller's: the caller asked for a
  # snapshot, not for the blank page that had to be opened to take one.
  LEMMA_BROWSER_BOOTSTRAP=1 start-browser >/tmp/agent-browser-bootstrap.log 2>&1 || true
}

# Refuse to type over a person who has taken the wheel.
#
# Two parties drive one page: the agent, and a person through the relay's
# control socket. The lease that coordinates them -- a file the relay writes
# for as long as that socket is open -- was read in exactly one place, the
# script the *typed* browser tools run. The browser skill teaches the raw CLI
# as "the core loop", so an agent following its own documentation walked
# straight past the guard and typed into the page somebody was entering a
# password into. Enforced here instead: this wrapper is where every
# `agent-browser` command enters, typed or not.
#
# `LEMMA_WHEEL_BYPASS` is the relay's way past it, and it is not a loophole:
# the relay's own commands -- the keepalive, the steer to the sign-in site,
# the state capture when the person says they are done -- run *for* whoever
# is holding the wheel. Refusing those would retire the browser under them
# and lose the sign-in, which is the failure this whole guard exists to stop.
DRIVING_MARKER=__LEMMA_PERSON_IS_DRIVING__
DRIVING_EXIT_CODE=91
refuse_if_somebody_is_driving() {
  if [ -n "${LEMMA_WHEEL_BYPASS:-}" ]; then
    return 0
  fi
  # Info-only flags never touch the page, and the same list is left alone by
  # the bootstrap above for the same reason.
  case "${1:-}" in
    ""|--version|-v|--help|-h|help)
      return 0
      ;;
  esac
  wheel_dir="${LEMMA_WHEEL_DIR:-/tmp/lemma-relay/wheel}"
  # The session's own lease, named the way the relay names it (a sha256 of the
  # session, first 32 characters) -- so a person signing in to one site does
  # not stop an agent working in another.
  #
  # `sha256sum` is coreutils and is always in the image; `shasum` is the BSD
  # spelling, which is what a developer running these tests on a Mac has. If
  # neither is here the lease cannot be read at all, and the honest answer is
  # to let the command through rather than to refuse every browser call in the
  # sandbox on the strength of a missing checksum tool -- the same way
  # `_require_private` treats a probe it cannot complete.
  if command -v sha256sum >/dev/null 2>&1; then
    digest="$(printf %s "${AGENT_BROWSER_SESSION:-workspace}" | sha256sum | cut -c1-32)"
  elif command -v shasum >/dev/null 2>&1; then
    digest="$(printf %s "${AGENT_BROWSER_SESSION:-workspace}" | shasum -a 256 | cut -c1-32)"
  else
    return 0
  fi
  if [ -e "$wheel_dir/$digest" ]; then
    printf '%s\n' "$DRIVING_MARKER" >&2
    printf '%s\n' "The person has taken control of this browser and is using it right now. Do not send browser commands while they are driving -- you would be typing into the same page they are. Wait, or say what you were about to do and let them finish." >&2
    exit "$DRIVING_EXIT_CODE"
  fi
}

case "$tool" in
  agent-browser)
    pattern='*/node_modules/agent-browser/bin/agent-browser.js'
    # Before the bootstrap, not after: starting Xvfb and a browser for a
    # command that is about to be refused is work nobody asked for.
    refuse_if_somebody_is_driving "${1:-}"
    ensure_browser_started "${1:-}"
    ;;
  lit|liteparse)
    pattern='*/node_modules/@llamaindex/liteparse/dist/cli.js'
    ;;
  pnpm)
    pattern='*/node_modules/pnpm/bin/pnpm.mjs'
    ;;
  *)
    echo "unsupported Lemma Node tool: $tool" >&2
    exit 64
    ;;
esac

entrypoint="$(
  find "$NODE_PROJECT/node_modules/.pnpm" -path "$pattern" -print -quit
)"
if [ -z "$entrypoint" ]; then
  echo "Lemma Node tool is not installed: $tool" >&2
  exit 127
fi

exec "$NODE_BINARY" "$entrypoint" "$@"
