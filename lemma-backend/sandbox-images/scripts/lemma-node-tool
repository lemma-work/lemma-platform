#!/usr/bin/env bash
set -euo pipefail

if [ -n "${LEMMA_NODE_BINARY:-}" ]; then
  NODE_BINARY="$LEMMA_NODE_BINARY"
elif [ -x /opt/node24/bin/node ]; then
  NODE_BINARY="/opt/node24/bin/node"
else
  NODE_BINARY="node"
fi
NODE_PROJECT="${LEMMA_NODE_PROJECT:-/opt/lemma-node}"
tool="$(basename "$0")"

# Bring the browser up before a command that needs it.
#
# `lemma-ensure-display` is what writes the config and starts Xvfb, and the skill says
# to call it first. An agent that goes straight for `agent-browser` instead --
# the obvious thing to type, and what a model does when it has used this CLI
# anywhere else -- got one of two errors, neither of which names the remedy:
#
#     ⚠ config file not found: /tmp/lemma-browser/config.json
#     Missing X server or $DISPLAY
#
# Both mean "lemma-ensure-display has not run". Neither says so, so the reasonable
# conclusion from inside the sandbox is that the browser tooling is broken, and
# the fallback an agent reaches for is downloading Playwright and its own
# Chromium -- into a 2 GB sandbox, to do what the installed browser already
# does. Observed in a real transcript; this is the fix.
#
# Ordering stops being something the caller has to know. Info-only flags are
# left alone so `--version` never starts an X server, and the guard variable
# keeps `lemma-ensure-display`'s own nested calls from coming back through here.
ensure_browser_started() {
  if [ -n "${LEMMA_BROWSER_BOOTSTRAP:-}" ]; then
    return 0
  fi
  case "${1:-}" in
    ""|--version|-v|--help|-h|help)
      return 0
      ;;
  esac
  config="${AGENT_BROWSER_CONFIG:-/tmp/lemma-browser/config.json}"
  display="${DISPLAY:-:99}"
  display_number="${display#:}"
  display_number="${display_number%%.*}"
  # A running X server, not the socket it left behind. `/tmp/.X11-unix/X99` is
  # an ordinary file in the container's writable layer, so it outlives the
  # process that made it whenever Xvfb is killed rather than asked to stop --
  # an ungraceful container stop, a Docker daemon restart, a host reboot, a
  # quiesce that could not reach the runtime, or E2B, which pauses without
  # quiescing and keeps `/tmp`.
  #
  # Testing the socket meant this returned early in exactly those cases, so
  # `lemma-ensure-display` -- the one thing that would have started Xvfb -- was never
  # called, and every browser command in the sandbox failed with "Missing X
  # server or $DISPLAY" for the life of the container. Fixing the same test
  # inside `lemma-ensure-display` was not enough on its own, because this guard is
  # what decides whether it runs at all.
  if [ -f "$config" ] && pgrep -f "Xvfb ${display} " >/dev/null 2>&1; then
    return 0
  fi
  command -v lemma-ensure-display >/dev/null 2>&1 || return 0
  # Its output is the bootstrap's, not the caller's: the caller asked for a
  # snapshot, not for the blank page that had to be opened to take one.
  LEMMA_BROWSER_BOOTSTRAP=1 lemma-ensure-display >/tmp/agent-browser-bootstrap.log 2>&1 || true
}

case "$tool" in
  agent-browser)
    pattern='*/node_modules/agent-browser/bin/agent-browser.js'
    ensure_browser_started "${1:-}"
    # Somebody watching is told the agent is driving while its commands keep
    # coming (`browser_relay/app.py`, `agent_active_seconds`). The relay runs
    # this wrapper too -- for its keepalive and the toolbar -- and says so, so
    # a person's own click is never shown as the agent's.
    if [ -z "${LEMMA_BROWSER_ACTOR:-}" ]; then
      mkdir -p /tmp/lemma-browser 2>/dev/null && : > /tmp/lemma-browser/agent-active 2>/dev/null || true
    fi
    ;;
  lit|liteparse)
    pattern='*/node_modules/@llamaindex/liteparse/dist/cli.js'
    ;;
  pnpm)
    pattern='*/node_modules/pnpm/bin/pnpm.mjs'
    ;;
  *)
    echo "unsupported Lemma Node tool: $tool" >&2
    exit 64
    ;;
esac

entrypoint="$(
  find "$NODE_PROJECT/node_modules/.pnpm" -path "$pattern" -print -quit
)"
if [ -z "$entrypoint" ]; then
  echo "Lemma Node tool is not installed: $tool" >&2
  exit 127
fi

# The session `agent-browser` would act in: `--session` wins over the
# environment, as it does in the CLI.
browser_session() {
  local previous=""
  for argument in "$@"; do
    if [ "$previous" = "--session" ]; then
      printf '%s' "$argument"
      return 0
    fi
    previous="$argument"
  done
  printf '%s' "${AGENT_BROWSER_SESSION:-default}"
}

# Whether that session's daemon is up, by its own pid file.
daemon_is_up() {
  local pid_file pid
  pid_file="${XDG_RUNTIME_DIR:-/tmp/lemma-browser/runtime}/agent-browser/$1.pid"
  pid="$(cat "$pid_file" 2>/dev/null)" || return 1
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

# One daemon start at a time, per session, across every caller.
#
# A CLI that finds no daemon starts one. Two at once -- the relay opening the
# view while `lemma-ensure-display` opens about:blank, an agent's command
# beside the keepalive -- each start a daemon and a Chrome on the same
# profile. The second Chrome hands off to the first and, leaving, takes the
# profile's DevToolsActivePort with it, so the browser that is running can no
# longer be found; the orphaned daemon later exits and deletes the live one's
# socket, and the next command starts the cycle again. Measured on Docker and
# on E2B. The relay's own lock covers only the relay.
#
# So a command that would start a daemon waits its turn, and looks again once
# it has it: whoever went first has usually started the daemon by then. With a
# daemon up, nothing waits. `-o`, because the lock must not pass to the daemon
# the CLI forks -- it would hold it for its whole life.
if [ "$tool" = "agent-browser" ] && command -v flock >/dev/null 2>&1; then
  session="$(browser_session "$@")"
  if ! daemon_is_up "$session"; then
    locks="${XDG_RUNTIME_DIR:-/tmp/lemma-browser/runtime}/agent-browser"
    mkdir -p "$locks" 2>/dev/null || true
    exec flock -o -w 240 "$locks/$session.start.lock" "$NODE_BINARY" "$entrypoint" "$@"
  fi
fi

exec "$NODE_BINARY" "$entrypoint" "$@"
